{
  "manifest_version": 3,
  "name": "PDF-AI Bridge",
  "version": "0.1.0",
  "description": "Local bridge companion for PDF-AI.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PDF-AI Bridge",
    "default_popup": "popup.html"
  }
}
